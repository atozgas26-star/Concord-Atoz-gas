rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }
    function isValidMemberUids(listVal) {
      return listVal is list &&
             listVal.size() >= 1 &&
             listVal.size() <= 20 &&
             listVal[0] is string;
    }
    function isBootstrappedAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'atozgas26@gmail.com' &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }
    function userProfileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    function userHasAdminRole() {
      return isSignedIn() &&
             userProfileExists(request.auth.uid) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    function isOwnerViewUser() {
      return isSignedIn() &&
             userProfileExists(request.auth.uid) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER_VIEW';
    }
    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }
    function workspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
             workspaceExists(workspaceId) &&
             (isBootstrappedAdmin() || request.auth.uid in workspaceData(workspaceId).memberUids);
    }
    function isWritableWorkspaceMember(workspaceId) {
      return isWorkspaceMember(workspaceId) && !isOwnerViewUser();
    }
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
             !isOwnerViewUser() &&
             workspaceExists(workspaceId) &&
             (isBootstrappedAdmin() || workspaceData(workspaceId).ownerUid == request.auth.uid);
    }
    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() &&
             !isOwnerViewUser() &&
             workspaceExists(workspaceId) &&
             (
               isBootstrappedAdmin() ||
               workspaceData(workspaceId).ownerUid == request.auth.uid ||
               (request.auth.uid in workspaceData(workspaceId).memberUids && userHasAdminRole())
             );
    }
    function isWorkspaceExecutiveReader(workspaceId) {
      return isWorkspaceAdmin(workspaceId) || (isWorkspaceMember(workspaceId) && isOwnerViewUser());
    }

    // --- ENTITY VALIDATION HELPERS ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'STAFF', 'OWNER_VIEW'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('activeWorkspaceId' in data) || (data.activeWorkspaceId is string && data.activeWorkspaceId.size() <= 128)) &&
             (!('linkedStaffUsername' in data) || (data.linkedStaffUsername is string && data.linkedStaffUsername.size() <= 64)) &&
             (!('linkedStaffRole' in data) || (data.linkedStaffRole in ['', 'ADMIN', 'STAFF', 'OWNER_VIEW'])) &&
             (!('autoDriveBackupEnabled' in data) || (data.autoDriveBackupEnabled is bool)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function canSetLinkedStaffRole(data) {
      return !('linkedStaffRole' in data) ||
             data.linkedStaffRole != 'ADMIN' ||
             isBootstrappedAdmin() ||
             data.role == 'ADMIN' ||
             (
               ('activeWorkspaceId' in data) &&
               data.activeWorkspaceId is string &&
               data.activeWorkspaceId.size() >= 1 &&
               isWorkspaceAdmin(data.activeWorkspaceId)
             );
    }

    function isValidWorkspaceInvite(data) {
      return data.workspaceId is string && isValidId(data.workspaceId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWorkspace(data) {
      return data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidMemberUids(data.memberUids) &&
             data.activeInviteCode is string && isValidId(data.activeInviteCode) &&
             data.activeInviteCode.size() >= 4 && data.activeInviteCode.size() <= 64 &&
             (!('lastJoinInviteCode' in data) || (data.lastJoinInviteCode is string && data.lastJoinInviteCode.size() <= 64)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStaffAccount(data) {
      return data.localId is int && data.localId >= 1 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'STAFF'] &&
             (!('pin' in data) || (data.pin is string && (data.pin == '' || data.pin.matches('^[0-9]{4}$')))) &&
             (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 256)) &&
             data.active is bool &&
             isValidMemberUids(data.memberUids) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVehicle(data) {
      return data.localId is int && data.localId >= 1 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
             data.staffUserId is int && data.staffUserId >= 1 &&
             data.active is bool &&
             isValidMemberUids(data.memberUids) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProductCategory(data) {
      return data.localId is int && data.localId >= 1 &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 64 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
             (!('iconKey' in data) || (data.iconKey is string && data.iconKey.size() <= 40)) &&
             (!('categoryType' in data) || (data.categoryType is string && data.categoryType.size() <= 40)) &&
             data.legacyEnum in ['INDUSTRIAL_GAS', 'SMALL_48_CFT', 'COOKING_GAS', 'MCG_CUTTING_GAS'] &&
             data.sortOrder is int && data.sortOrder >= 0 &&
             data.active is bool &&
             (!('systemDefault' in data) || (data.systemDefault is bool)) &&
             isValidMemberUids(data.memberUids) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProduct(data) {
      return data.localId is int && data.localId >= 1 &&
             data.category in ['INDUSTRIAL_GAS', 'SMALL_48_CFT', 'COOKING_GAS', 'MCG_CUTTING_GAS'] &&
             (!('categoryId' in data) || (data.categoryId is int && data.categoryId >= 1)) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.sortOrder is int && data.sortOrder >= 0 &&
             data.active is bool &&
             (!('cylinderSizeKg' in data) || (data.cylinderSizeKg is string && data.cylinderSizeKg.size() <= 40)) &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 30)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
             (!('iconKey' in data) || (data.iconKey is string && data.iconKey.size() <= 40)) &&
             isValidMemberUids(data.memberUids) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidOpening(data) {
      return data.scope in ['STORE', 'VEHICLE'] &&
             data.vehicleId is int && data.vehicleId >= 0 &&
             data.productId is int && data.productId >= 1 &&
             data.openingFull is int &&
             data.openingEmpty is int &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 100 &&
             isValidMemberUids(data.memberUids) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isStaffAllowedTransactionType(txType) {
      return txType in [
        'VEHICLE_FULL_RECEIVED',
        'VEHICLE_FULL_RETURN_TO_STORE',
        'VEHICLE_CUSTOMER_SALE',
        'VEHICLE_NEW_CUSTOMER_SALE',
        'VEHICLE_CUSTOMER_COMPLAINT_REPLACE',
        'VEHICLE_EMPTY_FROM_CUSTOMER',
        'VEHICLE_EMPTY_RETURN_TO_STORE',
        'VEHICLE_CUSTOMER_CHANGE_FULL_IN',
        'VEHICLE_CUSTOMER_CHANGE_FULL_OUT',
        'VEHICLE_CUSTOMER_CHANGE_EMPTY_IN',
        'VEHICLE_CUSTOMER_CHANGE_EMPTY_OUT',
        'VEHICLE_TRANSFER_FULL_OUT',
        'VEHICLE_TRANSFER_FULL_IN',
        'VEHICLE_TRANSFER_EMPTY_OUT',
        'VEHICLE_TRANSFER_EMPTY_IN',
        'VEHICLE_DAMAGED_ADD',
        'VEHICLE_DAMAGED_REMOVE',
        'CUSTOMER_EMPTY_PENDING_ADD'
      ];
    }

    function isValidTransaction(data) {
      return data.clientTxId is string && isValidId(data.clientTxId) &&
             data.businessDate is string && data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.clientTimestampMs is int && data.clientTimestampMs > 0 &&
             data.type in [
               'STORE_PURCHASE_FULL',
               'STORE_PURCHASE_EMPTY',
               'STORE_PURCHASE_COMPLAINT_REPLACE',
               'STORE_FULL_INWARD',
               'STORE_EMPTY_INWARD',
               'STORE_FULL_DISPATCH_DIRECT',
               'STORE_EMPTY_DISPATCH',
               'STORE_EMPTY_FROM_CUSTOMER',
               'STORE_CUSTOMER_CHANGE_FULL_IN',
               'STORE_CUSTOMER_CHANGE_FULL_OUT',
               'STORE_CUSTOMER_CHANGE_EMPTY_IN',
               'STORE_CUSTOMER_CHANGE_EMPTY_OUT',
               'STORE_ADJUST_FULL_IN',
               'STORE_ADJUST_FULL_OUT',
               'STORE_ADJUST_EMPTY_IN',
               'STORE_ADJUST_EMPTY_OUT',
               'STORE_DAMAGED_ADD',
               'STORE_DAMAGED_REMOVE',
               'VEHICLE_FULL_RECEIVED',
               'VEHICLE_FULL_RETURN_TO_STORE',
               'VEHICLE_CUSTOMER_SALE',
               'VEHICLE_NEW_CUSTOMER_SALE',
               'VEHICLE_CUSTOMER_COMPLAINT_REPLACE',
               'VEHICLE_EMPTY_FROM_CUSTOMER',
               'VEHICLE_EMPTY_RETURN_TO_STORE',
               'VEHICLE_CUSTOMER_CHANGE_FULL_IN',
               'VEHICLE_CUSTOMER_CHANGE_FULL_OUT',
               'VEHICLE_CUSTOMER_CHANGE_EMPTY_IN',
               'VEHICLE_CUSTOMER_CHANGE_EMPTY_OUT',
               'VEHICLE_TRANSFER_FULL_OUT',
               'VEHICLE_TRANSFER_FULL_IN',
               'VEHICLE_TRANSFER_EMPTY_OUT',
               'VEHICLE_TRANSFER_EMPTY_IN',
               'VEHICLE_ADJUST_FULL_IN',
               'VEHICLE_ADJUST_FULL_OUT',
               'VEHICLE_ADJUST_EMPTY_IN',
               'VEHICLE_ADJUST_EMPTY_OUT',
               'VEHICLE_DAMAGED_ADD',
               'VEHICLE_DAMAGED_REMOVE',
               'CUSTOMER_EMPTY_PENDING_ADD'
             ] &&
             data.productId is int && data.productId >= 1 &&
             (!('vehicleId' in data) || (data.vehicleId is int && data.vehicleId >= 1)) &&
             (!('vehicleName' in data) || (data.vehicleName is string && data.vehicleName.size() >= 1 && data.vehicleName.size() <= 64)) &&
             data.staffId is int && data.staffId >= 1 &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
             data.quantity is int && data.quantity > 0 && data.quantity <= 100000 &&
             (!('purchaseCompanyName' in data) || (data.purchaseCompanyName is string && data.purchaseCompanyName.size() <= 120)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120)) &&
             data.notes is string && data.notes.size() <= 300 &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             isValidMemberUids(data.memberUids) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdminSettings(data, settingId) {
      return data.settingId == settingId &&
             data.settingId is string && isValidId(data.settingId) &&
             data.autoDriveBackupEnabled is bool &&
             data.lastDriveBackupAtMs is int && data.lastDriveBackupAtMs >= 0 &&
             data.lastDriveFileId is string && data.lastDriveFileId.size() <= 256 &&
             data.lastDriveBackupStatus is string && data.lastDriveBackupStatus.size() <= 300 &&
             (!('driveAccountEmail' in data) || (data.driveAccountEmail is string && data.driveAccountEmail.size() <= 200)) &&
             (!('themePreset' in data) || (data.themePreset is string && data.themePreset.size() <= 64)) &&
             (!('autoLogoutMode' in data) || (data.autoLogoutMode is string && data.autoLogoutMode.size() <= 64)) &&
             (!('adminLoginUsername' in data) || (data.adminLoginUsername is string && data.adminLoginUsername.size() <= 64)) &&
             (!('adminPasswordHash' in data) || (data.adminPasswordHash is string && data.adminPasswordHash.size() <= 256)) &&
             (!('adminRecoveryEmail' in data) || (data.adminRecoveryEmail is string && data.adminRecoveryEmail.size() <= 200)) &&
             (!('ownerViewPasswordHash' in data) || (data.ownerViewPasswordHash is string && data.ownerViewPasswordHash.size() <= 256)) &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStaffLoginEvent(data, eventId) {
      return data.eventId == eventId &&
             data.eventId is string && isValidId(data.eventId) &&
             data.staffId is int && data.staffId >= 1 &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
             (!('vehicleName' in data) || (data.vehicleName is string && data.vehicleName.size() <= 64)) &&
             data.loginTimestampMs is int && data.loginTimestampMs > 0 &&
             data.loginByUid is string && data.loginByUid.size() >= 1 && data.loginByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidAdminReport(data, reportId) {
      return data.reportId == reportId &&
             data.reportId is string && isValidId(data.reportId) &&
             data.reportType in [
               'DAILY_STORE',
               'DAILY_VEHICLE',
               'STAFF_PRODUCT_SALES',
               'PURCHASE_COMPANY_PRODUCT',
               'MONTHLY_SALES',
               'PRODUCT_WISE_SALES',
               'STAFF_WISE_SALES',
               'FULL_EMPTY_STOCK',
               'PURCHASE_REGISTER',
               'CUSTOMER_PENDING',
               'STAFF_WORK_HOURS',
               'LPG_EXCHANGE_REPORT'
             ] &&
             data.reportTitle is string && data.reportTitle.size() >= 1 && data.reportTitle.size() <= 160 &&
             data.subtitle is string && data.subtitle.size() <= 300 &&
             data.businessDate is string && data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.yearMonth is string && data.yearMonth.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.generatedBy is string && data.generatedBy.size() >= 1 && data.generatedBy.size() <= 100 &&
             data.rowCount is int && data.rowCount >= 0 &&
             data.summaryTotals is string && data.summaryTotals.size() <= 500 &&
             (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 256)) &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStaffAttendance(data, attendanceId) {
      return data.attendanceId == attendanceId &&
             data.attendanceId is string && isValidId(data.attendanceId) &&
             data.businessDate is string && data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.staffId is int && data.staffId >= 1 &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
             data.vehicleName is string && data.vehicleName.size() <= 64 &&
             data.dutyStartMs is int && data.dutyStartMs >= 0 &&
             data.lunchOutMs is int && data.lunchOutMs >= 0 &&
             data.lunchInMs is int && data.lunchInMs >= 0 &&
             data.dutyCloseMs is int && data.dutyCloseMs >= 0 &&
             data.updatedAtMs is int && data.updatedAtMs > 0 &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidMemberUids(data.memberUids) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPendingStoreTransfer(data, requestId) {
      return data.requestId == requestId &&
             data.requestId is string && isValidId(data.requestId) &&
             data.businessDate is string && data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.direction in ['STORE_TO_VEHICLE_FULL', 'VEHICLE_TO_STORE_FULL', 'VEHICLE_TO_STORE_EMPTY'] &&
             data.vehicleId is int && data.vehicleId >= 1 &&
             data.vehicleName is string && data.vehicleName.size() >= 1 && data.vehicleName.size() <= 64 &&
             data.productId is int && data.productId >= 1 &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 100 &&
             data.productCategory is string && data.productCategory.size() <= 64 &&
             data.quantity is int && data.quantity > 0 && data.quantity <= 100000 &&
             data.staffId is int && data.staffId >= 1 &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.requestedAtMs is int && data.requestedAtMs > 0 &&
             data.reviewedAtMs is int && data.reviewedAtMs >= 0 &&
             data.reviewedBy is string && data.reviewedBy.size() <= 100 &&
             data.reviewNotes is string && data.reviewNotes.size() <= 300 &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             isValidMemberUids(data.memberUids) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAppNotification(data, notifId) {
      return data.notifId == notifId &&
             data.notifId is string && isValidId(data.notifId) &&
             data.targetScope in ['ALL', 'ADMIN_OWNER', 'STAFF'] &&
             data.targetStaffId is int && data.targetStaffId >= 0 &&
              data.category in ['TRANSFER_EXTRA', 'STORE_APPROVAL', 'ATTENDANCE', 'CHAT_IMPORTANT', 'SYSTEM_UPDATE', 'SECURITY_ALERT', 'INFO'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             data.isUrgent is bool &&
             data.createdAtMs is int && data.createdAtMs > 0 &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             isValidMemberUids(data.memberUids) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidChatMessage(data, messageId) {
      return data.messageId == messageId &&
             data.messageId is string && isValidId(data.messageId) &&
             data.channel in ['TEAM_CHAT', 'ADMIN_OWNER'] &&
             data.senderId is int && data.senderId >= 0 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.senderRole in ['ADMIN', 'OWNER_VIEW', 'STAFF'] &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
             data.isImportant is bool &&
             data.createdAtMs is int && data.createdAtMs > 0 &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             isValidMemberUids(data.memberUids) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidTypingStatus(data, typingId) {
      return data.typingId == typingId &&
             data.typingId is string && isValidId(data.typingId) &&
             data.channel in ['TEAM_CHAT', 'ADMIN_OWNER'] &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.senderRole in ['ADMIN', 'OWNER_VIEW', 'STAFF'] &&
             data.isTyping is bool &&
             data.updatedAtMs is int && data.updatedAtMs > 0 &&
             data.updatedByUid == request.auth.uid;
    }

    function isValidAuthorizedMobile(data, mobileId) {
      return data.mobileId == mobileId &&
             data.mobileId is string && isValidId(data.mobileId) &&
             data.phoneE164 is string && data.phoneE164.matches('^\\+9715[0-9]{8}$') &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'STAFF', 'OWNER_VIEW'] &&
             (!('staffUserId' in data) || (data.staffUserId is int && data.staffUserId >= 1)) &&
             data.allowedFeaturesCsv is string && data.allowedFeaturesCsv.size() <= 300 &&
             data.isActive is bool &&
             data.isProtectedOwner is bool &&
             (!('firstTimeRegEnabled' in data) || (data.firstTimeRegEnabled is bool)) &&
             (!('isRegistered' in data) || (data.isRegistered is bool)) &&
             (!('otpVerifiedAtMs' in data) || (data.otpVerifiedAtMs is int && data.otpVerifiedAtMs >= 0)) &&
             (!('registeredDeviceId' in data) || (data.registeredDeviceId is string && data.registeredDeviceId.size() <= 120)) &&
             data.createdAtMs is int && data.createdAtMs > 0 &&
             data.updatedAtMs is int && data.updatedAtMs > 0 &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRegisteredDevice(data, deviceId) {
      return data.deviceId == deviceId &&
             data.deviceId is string && isValidId(data.deviceId) &&
             data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 120 &&
             data.phoneE164 is string && data.phoneE164.size() <= 30 &&
             data.userId is int && data.userId >= 0 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'STAFF', 'OWNER_VIEW'] &&
             data.sessionVersion is int && data.sessionVersion >= 1 &&
             data.isRevoked is bool &&
             data.lastActiveMs is int && data.lastActiveMs > 0 &&
             data.registeredAtMs is int && data.registeredAtMs > 0 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSecurityAuditLog(data, logId) {
      return data.logId == logId &&
             data.logId is string && isValidId(data.logId) &&
             data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 60 &&
             data.role is string && data.role.size() >= 1 && data.role.size() <= 30 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100 &&
             data.phoneE164 is string && data.phoneE164.size() <= 30 &&
             data.deviceLabel is string && data.deviceLabel.size() <= 120 &&
             data.details is string && data.details.size() <= 300 &&
             data.isAlert is bool &&
             data.timestampMs is int && data.timestampMs > 0 &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles (Strict owner isolation + Anti-privilege-escalation role enforcement)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) &&
                    (request.auth.uid == userId || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'role', 'activeWorkspaceId', 'linkedStaffUsername', 'linkedStaffRole', 'autoDriveBackupEnabled', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       (
                         incoming().role == 'STAFF' ||
                         (incoming().role == 'ADMIN' && isBootstrappedAdmin())
                       ) &&
                       canSetLinkedStaffRole(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           request.auth.uid == userId &&
                           ((!('role' in existing()) && incoming().role == 'STAFF') || (('role' in existing()) && incoming().role == existing().role) || isBootstrappedAdmin()) &&
                           canSetLinkedStaffRole(incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'role', 'activeWorkspaceId', 'linkedStaffUsername', 'linkedStaffRole', 'autoDriveBackupEnabled', 'updatedAt'])
                         ) ||
                         (
                           isBootstrappedAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isBootstrappedAdmin());
    }

    // 2. Workspace Invite Codes (Direct lookup by secret code; never listable)
    match /workspace_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       inviteCode.size() >= 4 &&
                       inviteCode.size() <= 64 &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['workspaceId', 'ownerUid', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['workspaceId', 'ownerUid', 'active', 'createdAt', 'updatedAt']) &&
                       isValidWorkspaceInvite(incoming()) &&
                       (isBootstrappedAdmin() || !workspaceExists(incoming().workspaceId) || isWorkspaceAdmin(incoming().workspaceId));

      allow update: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       isValidWorkspaceInvite(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().workspaceId == existing().workspaceId &&
                       incoming().createdAt == existing().createdAt &&
                       (isBootstrappedAdmin() || existing().ownerUid == request.auth.uid || isWorkspaceAdmin(existing().workspaceId)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(inviteCode) && (isBootstrappedAdmin() || existing().ownerUid == request.auth.uid);
    }

    // 3. Company Workspaces
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() &&
                    isValidId(workspaceId) &&
                    (request.auth.uid in existing().memberUids || existing().ownerUid == request.auth.uid || isBootstrappedAdmin());

      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll(['companyName', 'ownerUid', 'memberUids', 'activeInviteCode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['companyName', 'ownerUid', 'memberUids', 'activeInviteCode', 'lastJoinInviteCode', 'createdAt', 'updatedAt']) &&
                       isValidWorkspace(incoming());

      allow update: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       isValidWorkspace(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Owner, Bootstrapped Admin, or promoted Workspace Admin
                         (isWorkspaceAdmin(workspaceId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'memberUids', 'activeInviteCode', 'updatedAt'])) ||
                         // Staff self-join via valid active invite code
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'lastJoinInviteCode', 'updatedAt']) &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().lastJoinInviteCode is string &&
                           isValidId(incoming().lastJoinInviteCode) &&
                           exists(/databases/$(database)/documents/workspace_invites/$(incoming().lastJoinInviteCode)) &&
                           get(/databases/$(database)/documents/workspace_invites/$(incoming().lastJoinInviteCode)).data.workspaceId == workspaceId &&
                           get(/databases/$(database)/documents/workspace_invites/$(incoming().lastJoinInviteCode)).data.active == true
                         )
                       );

      allow delete: if isSignedIn() && isValidId(workspaceId) && (existing().ownerUid == request.auth.uid || isBootstrappedAdmin());

      // --- 3A. Staff & Admin Accounts (Read by members; mutated ONLY by Admin) ---
      match /staff_accounts/{accountId} {
        allow get: if isSignedIn() && isValidId(accountId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(accountId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['localId', 'username', 'displayName', 'role', 'active', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['localId', 'username', 'displayName', 'role', 'pin', 'pinHash', 'active', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidStaffAccount(incoming());

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(accountId) &&
                         isValidStaffAccount(incoming()) &&
                         incoming().localId == existing().localId &&
                         incoming().username == existing().username &&
                         incoming().role == existing().role &&
                         incoming().createdAt == existing().createdAt &&
                         (existing().role != 'ADMIN' || isWorkspaceOwner(workspaceId)) &&
                         (
                           (incoming().updatedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'pinHash', 'displayName', 'active', 'memberUids', 'updatedByUid', 'updatedAt'])) ||
                           (incoming().updatedByUid == existing().updatedByUid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                            incoming().memberUids == workspaceData(workspaceId).memberUids)
                         );

        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(accountId);
      }

      // --- 3B. Vehicles (Read by members; mutated ONLY by Admin) ---
      match /vehicles/{vehicleId} {
        allow get: if isSignedIn() && isValidId(vehicleId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(vehicleId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['localId', 'name', 'staffUserId', 'active', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['localId', 'name', 'staffUserId', 'active', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidVehicle(incoming());

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(vehicleId) &&
                         isValidVehicle(incoming()) &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (incoming().updatedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'staffUserId', 'active', 'memberUids', 'updatedByUid', 'updatedAt'])) ||
                           (incoming().updatedByUid == existing().updatedByUid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                            incoming().memberUids == workspaceData(workspaceId).memberUids)
                         );

        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(vehicleId);
      }

      // --- 3C. Products (Read by members; mutated ONLY by Admin) ---
      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(productId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(productId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['localId', 'category', 'name', 'sortOrder', 'active', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['localId', 'category', 'categoryId', 'name', 'sortOrder', 'active', 'cylinderSizeKg', 'unit', 'description', 'iconKey', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidProduct(incoming());

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (incoming().updatedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'categoryId', 'name', 'sortOrder', 'active', 'cylinderSizeKg', 'unit', 'description', 'iconKey', 'memberUids', 'updatedByUid', 'updatedAt'])) ||
                           (incoming().updatedByUid == existing().updatedByUid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                            incoming().memberUids == workspaceData(workspaceId).memberUids)
                         );

        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(productId);
      }

      // --- 3C-2. Dynamic Product Category Folders (Read by members; mutated ONLY by Admin) ---
      match /product_categories/{categoryId} {
        allow get: if isSignedIn() && isValidId(categoryId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(categoryId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['localId', 'code', 'name', 'legacyEnum', 'sortOrder', 'active', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['localId', 'code', 'name', 'description', 'iconKey', 'categoryType', 'legacyEnum', 'sortOrder', 'active', 'systemDefault', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidProductCategory(incoming());

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(categoryId) &&
                         isValidProductCategory(incoming()) &&
                         incoming().localId == existing().localId &&
                         incoming().code == existing().code &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (incoming().updatedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'iconKey', 'categoryType', 'legacyEnum', 'sortOrder', 'active', 'memberUids', 'updatedByUid', 'updatedAt'])) ||
                           (incoming().updatedByUid == existing().updatedByUid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                            incoming().memberUids == workspaceData(workspaceId).memberUids)
                         );

        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(categoryId);
      }

      // --- 3D. Opening Stocks (Read by members; mutated ONLY by Admin) ---
      match /openings/{openingId} {
        allow get: if isSignedIn() && isValidId(openingId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(openingId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['scope', 'vehicleId', 'productId', 'openingFull', 'openingEmpty', 'updatedBy', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['scope', 'vehicleId', 'productId', 'openingFull', 'openingEmpty', 'updatedBy', 'memberUids', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidOpening(incoming());

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(openingId) &&
                         isValidOpening(incoming()) &&
                         incoming().scope == existing().scope &&
                         incoming().vehicleId == existing().vehicleId &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (incoming().updatedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['openingFull', 'openingEmpty', 'updatedBy', 'memberUids', 'updatedByUid', 'updatedAt'])) ||
                           (incoming().updatedByUid == existing().updatedByUid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                            incoming().memberUids == workspaceData(workspaceId).memberUids)
                         );

        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(openingId);
      }

      // --- 3E. Stock Transactions (Staff create vehicle/customer entries only; Admin edit/delete/store) ---
      match /transactions/{txId} {
        allow get: if isSignedIn() && isValidId(txId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(workspaceId) &&
                         isValidId(txId) &&
                         incoming().clientTxId == txId &&
                         incoming().createdByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['clientTxId', 'businessDate', 'clientTimestampMs', 'type', 'productId', 'staffId', 'staffName', 'quantity', 'notes', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['clientTxId', 'businessDate', 'clientTimestampMs', 'type', 'productId', 'vehicleId', 'vehicleName', 'staffId', 'staffName', 'quantity', 'purchaseCompanyName', 'customerName', 'notes', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming()) &&
                         isWritableWorkspaceMember(workspaceId) &&
                         (isWorkspaceAdmin(workspaceId) || isStaffAllowedTransactionType(incoming().type));

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(txId) &&
                         isValidTransaction(incoming()) &&
                         incoming().clientTxId == existing().clientTxId &&
                         incoming().businessDate == existing().businessDate &&
                         incoming().type == existing().type &&
                         incoming().staffId == existing().staffId &&
                         incoming().staffName == existing().staffName &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                            incoming().memberUids == workspaceData(workspaceId).memberUids) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['productId', 'vehicleId', 'vehicleName', 'quantity', 'purchaseCompanyName', 'customerName', 'notes', 'memberUids', 'updatedAt']) &&
                            incoming().memberUids.hasAll(existing().memberUids))
                         );

        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(txId);
      }

      // --- 3F. Admin-Only Sensitive Settings & Google Drive Auto-Backup State ---
      match /admin_settings/{settingId} {
        allow get: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(settingId);
        allow list: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId);

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(settingId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().keys().hasAll(['settingId', 'autoDriveBackupEnabled', 'lastDriveBackupAtMs', 'lastDriveFileId', 'lastDriveBackupStatus', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['settingId', 'autoDriveBackupEnabled', 'lastDriveBackupAtMs', 'lastDriveFileId', 'lastDriveBackupStatus', 'driveAccountEmail', 'themePreset', 'autoLogoutMode', 'adminLoginUsername', 'adminPasswordHash', 'adminRecoveryEmail', 'ownerViewPasswordHash', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidAdminSettings(incoming(), settingId);

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(settingId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().settingId == existing().settingId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['autoDriveBackupEnabled', 'lastDriveBackupAtMs', 'lastDriveFileId', 'lastDriveBackupStatus', 'driveAccountEmail', 'themePreset', 'autoLogoutMode', 'adminLoginUsername', 'adminPasswordHash', 'adminRecoveryEmail', 'ownerViewPasswordHash', 'updatedByUid', 'updatedAt']) &&
                         isValidAdminSettings(incoming(), settingId);

        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(settingId);
      }

      // --- 3G. Executive & Admin Business Reports (Owner View strictly read-only) ---
      match /admin_reports/{reportId} {
        allow get: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId) && isValidId(reportId);
        allow list: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId);

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(reportId) &&
                         incoming().createdByUid == request.auth.uid &&
                         incoming().keys().hasAll(['reportId', 'reportType', 'reportTitle', 'subtitle', 'businessDate', 'yearMonth', 'generatedBy', 'rowCount', 'summaryTotals', 'createdByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['reportId', 'reportType', 'reportTitle', 'subtitle', 'businessDate', 'yearMonth', 'generatedBy', 'rowCount', 'summaryTotals', 'driveFileId', 'createdByUid', 'createdAt', 'updatedAt']) &&
                         isValidAdminReport(incoming(), reportId);

        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(reportId) &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().reportId == existing().reportId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['reportTitle', 'subtitle', 'rowCount', 'summaryTotals', 'driveFileId', 'updatedAt']) &&
                         isValidAdminReport(incoming(), reportId);

        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(reportId);
      }

      // --- 3H. Staff App Login Events (Staff log own sign-in; Admin/Owner View reads alerts) ---
      match /staff_login_events/{eventId} {
        allow get: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId) && isValidId(eventId);
        allow list: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId);

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(eventId) &&
                         incoming().loginByUid == request.auth.uid &&
                         incoming().keys().hasAll(['eventId', 'staffId', 'staffName', 'loginTimestampMs', 'loginByUid', 'createdAt']) &&
                         incoming().keys().hasOnly(['eventId', 'staffId', 'staffName', 'vehicleName', 'loginTimestampMs', 'loginByUid', 'createdAt']) &&
                         isValidStaffLoginEvent(incoming(), eventId);

        allow update: if false;
        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(eventId);
      }

      // --- 3I. Staff Daily Duty Attendance (Punch In / Lunch Out / Break In / Duty Close) ---
      match /staff_attendance/{attendanceId} {
        allow get: if isSignedIn() && isValidId(attendanceId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(attendanceId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['attendanceId', 'businessDate', 'staffId', 'staffName', 'vehicleName', 'dutyStartMs', 'lunchOutMs', 'lunchInMs', 'dutyCloseMs', 'updatedAtMs', 'updatedByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['attendanceId', 'businessDate', 'staffId', 'staffName', 'vehicleName', 'dutyStartMs', 'lunchOutMs', 'lunchInMs', 'dutyCloseMs', 'updatedAtMs', 'updatedByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isValidStaffAttendance(incoming(), attendanceId);

        allow update: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(attendanceId) &&
                         incoming().attendanceId == existing().attendanceId &&
                         incoming().businessDate == existing().businessDate &&
                         incoming().staffId == existing().staffId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedByUid == request.auth.uid &&
                         isValidStaffAttendance(incoming(), attendanceId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['staffName', 'vehicleName', 'dutyStartMs', 'lunchOutMs', 'lunchInMs', 'dutyCloseMs', 'updatedAtMs', 'updatedByUid', 'memberUids', 'updatedAt']);

        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(attendanceId);
      }

      // --- 3J. Pending Store-to-Vehicle Full & Vehicle-to-Store Empty Approvals ---
      match /pending_store_transfers/{requestId} {
        allow get: if isSignedIn() && isValidId(requestId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(requestId) &&
                         incoming().createdByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().status == 'PENDING' &&
                         incoming().reviewedAtMs == 0 &&
                         incoming().keys().hasAll(['requestId', 'businessDate', 'direction', 'vehicleId', 'vehicleName', 'productId', 'productName', 'productCategory', 'quantity', 'staffId', 'staffName', 'notes', 'status', 'requestedAtMs', 'reviewedAtMs', 'reviewedBy', 'reviewNotes', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['requestId', 'businessDate', 'direction', 'vehicleId', 'vehicleName', 'productId', 'productName', 'productCategory', 'quantity', 'staffId', 'staffName', 'notes', 'status', 'requestedAtMs', 'reviewedAtMs', 'reviewedBy', 'reviewNotes', 'createdByUid', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isValidPendingStoreTransfer(incoming(), requestId);

        // ONLY Workspace Admin can approve or reject staff store cylinder entries
        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(requestId) &&
                         incoming().requestId == existing().requestId &&
                         incoming().businessDate == existing().businessDate &&
                         incoming().direction == existing().direction &&
                         incoming().vehicleId == existing().vehicleId &&
                         incoming().productId == existing().productId &&
                         incoming().quantity == existing().quantity &&
                         incoming().staffId == existing().staffId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         isValidPendingStoreTransfer(incoming(), requestId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAtMs', 'reviewedBy', 'reviewNotes', 'memberUids', 'updatedAt']);

        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(requestId);
      }

      // --- 3K. Universal App Bell Notifications (Transfers, Approvals, Updates, Chat Alerts) ---
      match /app_notifications/{notifId} {
        allow get: if isSignedIn() && isValidId(notifId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(notifId) &&
                         incoming().createdByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['notifId', 'targetScope', 'targetStaffId', 'category', 'title', 'message', 'isUrgent', 'createdAtMs', 'createdByUid', 'memberUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['notifId', 'targetScope', 'targetStaffId', 'category', 'title', 'message', 'isUrgent', 'createdAtMs', 'createdByUid', 'memberUids', 'createdAt']) &&
                         isValidAppNotification(incoming(), notifId);

        allow update: if false;
        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(notifId);
      }

      // --- 3L. Team & Admin-Owner Chat Messages (With Important Flag) ---
      match /chat_messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) &&
                      (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId)) &&
                      (existing().channel == 'TEAM_CHAT' || isWorkspaceExecutiveReader(workspaceId));
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids &&
                       (resource.data.channel == 'TEAM_CHAT' || isWorkspaceExecutiveReader(workspaceId));

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(messageId) &&
                         incoming().createdByUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         (incoming().channel == 'TEAM_CHAT' || isWorkspaceAdmin(workspaceId)) &&
                         incoming().keys().hasAll(['messageId', 'channel', 'senderId', 'senderName', 'senderRole', 'message', 'isImportant', 'createdAtMs', 'createdByUid', 'memberUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['messageId', 'channel', 'senderId', 'senderName', 'senderRole', 'message', 'isImportant', 'createdAtMs', 'createdByUid', 'memberUids', 'createdAt']) &&
                         isValidChatMessage(incoming(), messageId);

        allow update: if false;
        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(messageId);
      }

      // --- 3M. Live Chat Typing Indicators ---
      match /typing_status/{typingId} {
        allow get: if isWorkspaceMember(workspaceId) && isValidId(typingId);
        allow list: if isWorkspaceMember(workspaceId);

        allow create, update: if isWritableWorkspaceMember(workspaceId) &&
                                 isValidId(workspaceId) &&
                                 isValidId(typingId) &&
                                 incoming().keys().hasAll(['typingId', 'channel', 'senderName', 'senderRole', 'isTyping', 'updatedAtMs', 'updatedByUid']) &&
                                 incoming().keys().hasOnly(['typingId', 'channel', 'senderName', 'senderRole', 'isTyping', 'updatedAtMs', 'updatedByUid']) &&
                                 isValidTypingStatus(incoming(), typingId);

        allow delete: if isWritableWorkspaceMember(workspaceId) && isValidId(typingId);
      }

      // --- 3N. Authorized UAE (+971) Mobile Allowlist (Protected Owner Immutable) ---
      match /authorized_mobiles/{mobileId} {
        allow get: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId) && isValidId(mobileId);
        allow list: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId);

        allow create: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(mobileId) &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().keys().hasAll(['mobileId', 'phoneE164', 'displayName', 'role', 'allowedFeaturesCsv', 'isActive', 'isProtectedOwner', 'createdAtMs', 'updatedAtMs', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['mobileId', 'phoneE164', 'displayName', 'role', 'staffUserId', 'allowedFeaturesCsv', 'isActive', 'isProtectedOwner', 'firstTimeRegEnabled', 'isRegistered', 'otpVerifiedAtMs', 'registeredDeviceId', 'createdAtMs', 'updatedAtMs', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                         isValidAuthorizedMobile(incoming(), mobileId);

        // Admin CANNOT alter, demote, or deactivate an existing Protected Owner mobile record
        allow update: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(mobileId) &&
                         existing().isProtectedOwner == false &&
                         incoming().mobileId == existing().mobileId &&
                         incoming().phoneE164 == existing().phoneE164 &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'staffUserId', 'allowedFeaturesCsv', 'isActive', 'isProtectedOwner', 'firstTimeRegEnabled', 'isRegistered', 'otpVerifiedAtMs', 'registeredDeviceId', 'updatedAtMs', 'updatedByUid', 'updatedAt']) &&
                         isValidAuthorizedMobile(incoming(), mobileId);

        allow delete: if isWorkspaceAdmin(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(mobileId) &&
                         existing().isProtectedOwner == false;
      }

      // --- 3O. Registered Devices & Session Revocation ---
      match /registered_devices/{deviceId} {
        allow get: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId) && isValidId(deviceId);
        allow list: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId);

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(deviceId) &&
                         incoming().ownerUid == request.auth.uid &&
                         (incoming().isRevoked == false || isWorkspaceAdmin(workspaceId)) &&
                         incoming().keys().hasAll(['deviceId', 'deviceLabel', 'phoneE164', 'userId', 'displayName', 'role', 'sessionVersion', 'isRevoked', 'lastActiveMs', 'registeredAtMs', 'ownerUid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['deviceId', 'deviceLabel', 'phoneE164', 'userId', 'displayName', 'role', 'sessionVersion', 'isRevoked', 'lastActiveMs', 'registeredAtMs', 'ownerUid', 'createdAt', 'updatedAt']) &&
                         isValidRegisteredDevice(incoming(), deviceId);

        allow update: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(deviceId) &&
                         incoming().deviceId == existing().deviceId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidRegisteredDevice(incoming(), deviceId) &&
                         (
                           isWorkspaceAdmin(workspaceId) ||
                           (existing().ownerUid == request.auth.uid && incoming().ownerUid == existing().ownerUid && incoming().isRevoked == existing().isRevoked)
                         ) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['deviceLabel', 'phoneE164', 'userId', 'displayName', 'role', 'sessionVersion', 'isRevoked', 'lastActiveMs', 'registeredAtMs', 'ownerUid', 'updatedAt']);

        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(deviceId);
      }

      // --- 3P. Security & Login Audit Logs (Immutable; Owner View read-only) ---
      match /security_logs/{logId} {
        allow get: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId) && isValidId(logId);
        allow list: if isWorkspaceExecutiveReader(workspaceId) && isValidId(workspaceId);

        allow create: if isWritableWorkspaceMember(workspaceId) &&
                         isValidId(workspaceId) &&
                         isValidId(logId) &&
                         incoming().createdByUid == request.auth.uid &&
                         incoming().keys().hasAll(['logId', 'eventType', 'role', 'actorName', 'phoneE164', 'deviceLabel', 'details', 'isAlert', 'timestampMs', 'createdByUid', 'createdAt']) &&
                         incoming().keys().hasOnly(['logId', 'eventType', 'role', 'actorName', 'phoneE164', 'deviceLabel', 'details', 'isAlert', 'timestampMs', 'createdByUid', 'createdAt']) &&
                         isValidSecurityAuditLog(incoming(), logId);

        allow update: if false;
        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) && isValidId(logId);
      }
    }
  }
}
